{
  "name": "Cave",
  "type": "object",
  "properties": {
    "catalog_number": {
      "type": "number",
      "description": "Original catalog number from the registry"
    },
    "name": {
      "type": "string",
      "description": "Name of the cave"
    },
    "synonyms": {
      "type": "string",
      "description": "Alternative names"
    },
    "type_1": {
      "type": "string",
      "description": "Morphological type code 1"
    },
    "type_2": {
      "type": "string",
      "description": "Morphological type code 2"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude coordinate"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude coordinate"
    },
    "entrance_elevation_m": {
      "type": "number",
      "description": "Entrance elevation in meters"
    },
    "length_m": {
      "type": "number",
      "description": "Length in meters"
    },
    "depth_m": {
      "type": "number",
      "description": "Depth in meters"
    },
    "survey_method": {
      "type": "string",
      "description": "How the cave was surveyed (lidar, TK-50, etc.)"
    },
    "cadastral_municipality": {
      "type": "string",
      "description": "Cadastral municipality"
    },
    "administrative_unit": {
      "type": "string",
      "description": "Administrative unit (ob\u010dina)"
    },
    "entry_regime": {
      "type": "string",
      "description": "Entry regime (prost vstop, nadzorovan vstop, etc.)"
    },
    "access": {
      "type": "string",
      "description": "Access condition (dostop neoviran, zaklenjena, etc.)"
    },
    "general_condition": {
      "type": "string",
      "description": "General condition of the cave"
    },
    "archaeological": {
      "type": "string",
      "description": "Archaeological significance (da/ne)"
    },
    "cave_system": {
      "type": "string",
      "description": "Cave system name if part of one"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "organization": {
      "type": "string",
      "description": "Surveying organization"
    }
  },
  "required": [
    "name"
  ]
}